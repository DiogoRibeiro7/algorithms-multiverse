prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@/algorithms_multiverse

Name: AlgorithmsMultiverseFortran
Description: Comprehensive collection of algorithms in Fortran
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lalgorithms_multiverse
Cflags: -I${includedir}